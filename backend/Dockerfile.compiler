# compiler 이미지. 빌드 컨텍스트는 backend/ (docker build -f Dockerfile.compiler backend/).
# rust 이미지 태그는 https://hub.docker.com/v2/repositories/library/rust/tags 와
# https://static.rust-lang.org/dist/channel-rust-stable.toml 로 확인한 값 (rustc 1.99.1).
FROM golang:1.27.3-trixie AS build
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
	--mount=type=cache,target=/root/.cache/go-build \
	CGO_ENABLED=0 go build -trimpath -o /out/compiler ./cmd/compiler

FROM rust:1.99.1-slim-trixie
RUN rustup target add wasm32-wasip1 \
	&& mkdir /work && chown 65532:65532 /work
COPY --from=build /out/compiler /usr/local/bin/compiler
USER 65532:65532
ENV WORK_DIR=/work
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/compiler"]
