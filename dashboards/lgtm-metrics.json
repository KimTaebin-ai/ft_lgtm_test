{
  "uid": "lgtm-metrics",
  "title": "LGTM Metrics",
  "tags": [
    "lgtm"
  ],
  "description": "Dashboard 1 (Metrics). provisioning 파일: 수정은 이 파일에서 하고 make deploy 로 반영한다.",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "성공 실행 수",
      "description": "선택한 시간 범위 동안 status=success 실행 수. increase 기반이라 backend 재시작에도 값이 줄지 않는다.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(increase(lgtm_executions_total{status=\"success\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "성공"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value"
      }
    },
    {
